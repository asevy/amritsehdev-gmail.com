{
  "name": "reclaim-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "predev": "node scripts/setup-pose.mjs",
    "build": "next build",
    "prebuild": "node scripts/setup-pose.mjs && node scripts/compliance-lint.mjs",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --test scripts/mechanics.test.ts",
    "compliance": "node scripts/compliance-lint.mjs",
    "check": "npm run typecheck && npm test && npm run compliance",
    "setup:pose": "node scripts/setup-pose.mjs",
    "media": "node scripts/make-placeholder-media.mjs",
    "db:reset": "node -e \"require('fs').rmSync('.data',{recursive:true,force:true});console.log('Deleted .data \u2014 demo data reseeds on next request')\""
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@mediapipe/tasks-vision": "^1.2.3",
    "geist": "^1.9.2",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "postcss": "^8.5.33",
    "tailwindcss": "^4.3.5",
    "typescript": "5.9"
  },
  "engines": {
    "node": ">=22.18.0 <23"
  }
}
