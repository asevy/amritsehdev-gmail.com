# Junior Mining Intelligence — environment template. No secrets belong here.
# Copy to .env (never commit .env) and export before `python -m jmi serve`.

# Where the database, original document bytes (per tenant) and backups live.
# Use an encrypted volume in any non-development deployment.
JMI_DATA_DIR=./data

# Bind address. Keep 127.0.0.1 and put a TLS reverse proxy in front.
JMI_HOST=127.0.0.1
JMI_PORT=8780

# Coverage status thresholds (describe the evidence base, not the company).
JMI_FRESHNESS_DAYS=120
JMI_MARKET_DATA_STALE_DAYS=7

JMI_SESSION_TTL_SECONDS=28800
JMI_MAX_UPLOAD_BYTES=50000000

# Model provider for candidate proposal. "none" = deterministic extraction only.
# No provider is configured or tested in this build; see docs/DATA_SOURCES.md.
JMI_MODEL_PROVIDER=none
# Provider credentials, if one is ever enabled, go in the deployment's secret
# manager — not in this file and not in the repository.

# Optional JSON file with plan/seat/entitlement configuration (no prices are
# hard-coded; none are validated market prices).
# JMI_PLANS_FILE=./plans.json
